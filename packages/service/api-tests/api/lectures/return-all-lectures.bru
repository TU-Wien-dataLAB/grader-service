meta {
  name: return-all-lectures
  type: http
  seq: 1
}

get {
  url: {{grader-base-url}}/api/lectures
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.lectures: isDefined
  res.body.page: isDefined
  res.body.per_page: isDefined
  res.body.total_items: isDefined
  res.body.total_pages: isDefined
}
